# Copy to .env and fill in. Never commit .env.

# --- Database (matches docker-compose.yml) ---
DATABASE_URL=postgresql+asyncpg://study:study@localhost:5433/study_companion

# --- Auth ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-generate-a-real-secret
# Optional: only needed for Google sign-in
GOOGLE_CLIENT_ID=

# --- LLM providers (PRD 10.1) ---
# Gemini: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Groq:   https://console.groq.com/keys            (key starts with gsk_)
# Groq also powers Whisper speech-to-text on the same key.
GROQ_API_KEY=

# Model IDs. The defaults below are what is live today — every model the PRD
# named has since been retired. Override here if the providers move again.
# GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
# GEMINI_JSON_MODEL=gemini-3.5-flash
# GEMINI_EMBED_MODEL=gemini-embedding-001
# GROQ_FALLBACK_MODEL=openai/gpt-oss-120b
# GROQ_STT_MODEL=whisper-large-v3-turbo
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# --- CORS (comma separated) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# --- Code sandbox ---
SANDBOX_ENABLED=true
SANDBOX_IMAGE=python:3.12-slim
SANDBOX_TIMEOUT_SECONDS=8
# Falls back to a local subprocess when Docker isn't running.
# Fine for a single-user demo; set false for any shared deployment.
SANDBOX_ALLOW_LOCAL_FALLBACK=true

# --- Optional overrides ---
# ENVIRONMENT=development
# DEBUG=true
# SUPPORTED_LANGUAGES=en,hi
# MAX_TOPICS_PER_SUBJECT=50
# ASSESSMENT_DEFAULT_LENGTH=10
# MASTERY_DECAY_PER_DAY=1.5
