{
  "name": "study-companion",
  "private": true,
  "description": "AI Smart Study Companion — run the FastAPI backend and React frontend together.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "node scripts/dev.mjs --api",
    "dev:web": "node scripts/dev.mjs --web",
    "stop": "node scripts/stop.mjs",
    "setup": "node scripts/setup.mjs",
    "db:up": "docker compose --project-directory server up -d",
    "db:down": "docker compose --project-directory server down",
    "build": "npm --prefix client run build",
    "lint": "npm --prefix client run lint",
    "test": "node scripts/test.mjs",
    "test:contract": "node client/scripts/contract-test.mjs"
  }
}
